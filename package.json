{
	"name": "ps-list2",
	"version": "1.0.0-alpha.1",
	"description": "Get running processes",
	"license": "MIT",
	"repository": "aztack/ps-list2",
	"author": {
		"name": "aztack",
		"email": "aztack@163.com"
	},
	"main": "./dist/index.csj",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		"require": "./dist/index.cjs",
		"import": "./dist/index.js"
	},
	"engines": {
		"node": "^12.20.0 || ^14.13.1 || >=16.0.0"
	},
	"scripts": {
		"build": "node esbuild.js && npm run tsc",
		"tsc": "tsc src/index.ts --declaration --emitDeclarationOnly --outDir ./dist --esModuleInterop --module esnext --target es2020"
	},
	"files": [
		"index.js",
		"index.d.ts",
		"vendor/*.exe"
	],
	"keywords": [
		"ps",
		"proc",
		"process",
		"processes",
		"list",
		"running",
		"tasklist"
	],
	"devDependencies": {
		"@types/node": "^14.18.63",
		"ava": "^3.15.0",
		"esbuild": "^0.25.6",
		"esbuild-plugin-replace": "^1.4.0",
		"tsd": "^0.18.0",
		"xo": "^0.46.4"
	}
}
